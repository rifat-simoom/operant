# Operant Configuration
# Copy this file to .env and fill in the values

# Server port (default: 3100)
PORT=3100

# App port hint for MCP clients that spawn the stdio server
OPERANT_PORT=3100

# Override the shared SQLite path if needed
# OPERANT_DB_PATH=/absolute/path/to/operant.db

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Slack notifications (optional)
# SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL=
